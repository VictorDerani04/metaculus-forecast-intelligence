# Required in production. SESSION_SECRET must be a unique non-placeholder value of at least 32 characters.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://forecast:forecast@localhost:5432/forecast_intelligence
SESSION_SECRET=REPLACE_WITH_A_UNIQUE_32_PLUS_CHARACTER_SECRET
COOKIE_SECURE=false
PRIVATE_USER_EMAIL=owner@example.com
PRIVATE_USER_PASSWORD=replace-with-a-strong-password
# Development only: synchronize the configured private user's password at startup.
# Production rejects this setting.
SYNC_PRIVATE_USER_PASSWORD=true
# Explicit session lifetime in seconds (14 days).
SESSION_MAX_AGE_SECONDS=1209600

# Server-side only. Empty token enables manual fallback without a provider request.
METACULUS_API_TOKEN=
# Exact frontend origin, including port; no trailing slash.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional live research (production-only when configured; leave blank to disable).
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10

# Optional live AI classification (production-only when configured; leave blank to disable).
AI_CLASSIFIER_PROVIDER=
OPENAI_API_KEY=
AI_CLASSIFIER_MODEL=gpt-4o-mini
AI_CLASSIFIER_TIMEOUT_SECONDS=10

# Optional production email delivery. Leave unset to disable real delivery.
NOTIFICATION_PROVIDER=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=
NOTIFICATION_API_KEY=
NOTIFICATION_TIMEOUT_SECONDS=10
